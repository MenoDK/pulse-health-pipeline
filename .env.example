# Every value below is a placeholder. Copy to `.env` for local runs of `pulse` or `uvicorn` outside Docker.
# `make demo` does not need this file: docker-compose.yml carries the same defaults for the demonstration stack.
# Real deployments set these from a secret store, not from a file in the repository.

# --- runtime -----------------------------------------------------------------------------------------------------
# Anything other than development / dev / local / test is treated as a real deployment, and the service then refuses
# to start with the demonstration API key, the demonstration pseudonymisation key, the lab, or the stand-in controls.
APP_ENV=development
LOG_LEVEL=INFO
# The lab moves time and breaks the stand-ins. It has no login (it answers only to localhost) and is refused outside
# development. Serving the landing page needs SITE_DIR to point at the site folder.
LAB_MODE=false
SITE_DIR=
STANDIN_CONTROL=false

# --- access ------------------------------------------------------------------------------------------------------
# Sent as the X-API-Key header on every /api route outside the lab. At least 24 characters when APP_ENV is not a
# development one.
API_KEY=change-me

# --- stores ------------------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://pulse:pulse@localhost:15440/pulse
REDIS_URL=redis://localhost:16395/0
# Used by docker-compose.yml for the database container and by `make` for the loopback ports.
DB_PASSWORD=pulse
DB_PORT=15440
REDIS_PORT=16395
API_PORT=8300

# --- pseudonymisation --------------------------------------------------------------------------------------------
# A keyed hash of every direct identifier. At least 32 characters outside development. Changing it changes every
# pseudonym, so records stored under the old key no longer match new ones; the key id is stored beside each pseudonym
# so a rotation can be told apart from a mistake. There is no re-keying tool here (see Limitations in the README).
PSEUDONYM_KEY=demo-pseudonym-key-do-not-use-in-production
PSEUDONYM_KEY_ID=k1

# --- the source registry -----------------------------------------------------------------------------------------
REGISTRY_URL=http://localhost:9100
REGISTRY_TIMEOUT_SECONDS=10
SYNC_PAGE_SIZE=200

# --- the national gateway ----------------------------------------------------------------------------------------
GATEWAY_URL=https://localhost:9443
# Empty: <GATEWAY_URL>/oauth/token
GATEWAY_TOKEN_URL=
GATEWAY_CLIENT_ID=pulse-demo
GATEWAY_CLIENT_SECRET=pulse-demo-secret
# Mutual TLS: the CA that signed the gateway, and this service's client certificate and key.
GATEWAY_CA_FILE=
GATEWAY_CERT_FILE=
GATEWAY_KEY_FILE=
GATEWAY_TIMEOUT_SECONDS=5
TOKEN_MARGIN_SECONDS=60

# --- the transmission queue --------------------------------------------------------------------------------------
QUEUE_MAX_ATTEMPTS=10
QUEUE_LEASE_SECONDS=120
QUEUE_BATCH=50
QUEUE_BACKOFF_BASE_SECONDS=30
QUEUE_BACKOFF_CAP_SECONDS=21600

# --- search ------------------------------------------------------------------------------------------------------
EMBEDDING_DIM=256
SEARCH_RRF_K=60
